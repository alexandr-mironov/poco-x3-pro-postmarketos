-pkgrel=0
+pkgrel=1
 url="https://postmarketos.org"
 license="MIT"
 arch="aarch64"
@@ -29,6 +29,8 @@ subpackages="
 source="
 	deviceinfo
 	HiFi.conf
+	modules-initfs.huaxing
+	modules-initfs.tianma
 	vayu.conf
 "

