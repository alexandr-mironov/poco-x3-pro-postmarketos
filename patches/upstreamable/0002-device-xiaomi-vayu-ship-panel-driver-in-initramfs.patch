 device/testing/device-xiaomi-vayu/APKBUILD              | 6 +++++-
 device/testing/device-xiaomi-vayu/modules-initfs.huaxing | 1 +
 device/testing/device-xiaomi-vayu/modules-initfs.tianma  | 1 +
 3 files changed, 7 insertions(+), 1 deletion(-)

