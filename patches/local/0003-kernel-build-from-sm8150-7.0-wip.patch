-builddir="$srcdir/linux-$_tag"
+builddir="$srcdir/linux-$_commit"
 
 prepare() {
 	default_prepare
 	cp "$srcdir/config-$_flavor.$arch" .config
+	# Merge the in-tree sm8150 fragment: it carries the vayu-specific
+	# symbols introduced by MR !17 (huaxing/tianma NT36672 panels,
+	# NT36672 SPI touchscreen) that do not exist in the pmaports config.
+	# merge_config.sh needs GNU readlink -m, unavailable in the busybox
+	# based build chroot, so append the fragment and let olddefconfig
+	# resolve it (later assignments win).
+	sed "s/[[:space:]]*#.*$//" arch/arm64/configs/sm8150.config \
+		| grep "^CONFIG_" >> .config
+	make ARCH="$_carch" LLVM=1 olddefconfig
 }
 
